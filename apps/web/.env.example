# Dónde vive la API de cuentas. Copiá este archivo a .env.local para cambiarla.
#
# Si no está o no responde, el juego funciona igual: el bloque de la cuenta no
# aparece y todo se guarda en el navegador, como siempre.
VITE_API=http://localhost:5181

# El servidor de salas (WebSocket). Sin esto, el bloque de "con amigos" no
# conecta y el juego se queda en un jugador.
VITE_SALAS=ws://localhost:5182
